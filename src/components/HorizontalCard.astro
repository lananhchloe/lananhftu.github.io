---
// Editorial list row (no image). Used for blog posts and services.
const { title, desc, url, badge, tags, meta, target = "_blank" } = Astro.props;
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div class="row-item reveal">
  <div class="row-meta">{meta ?? "—"}</div>
  <div>
    <a href={url} target={target} class="row-title hover:text-white">
      {title}
      {badge && <span class="p-badge">{badge}</span>}
    </a>
    {desc && <p class="row-desc">{desc}</p>}
    {
      tags && tags.length > 0 && (
        <div class="row-tags">
          {tags.map((tag) => (
            <a href={`${tag_url}/${tag}`} class="chip !py-1 !px-3 !text-xs">
              #{tag}
            </a>
          ))}
        </div>
      )
    }
  </div>
  <a href={url} target={target} class="p-arrow" aria-label={`Open ${title}`}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
  </a>
</div>
